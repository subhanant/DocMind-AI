# ============================================================
# DocuMind AI — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ─── Application ────────────────────────────────────────────
APP_NAME=DocuMind AI
ENVIRONMENT=development
DEBUG=true

# ─── Security ────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_RANDOM_64_CHAR_HEX_STRING
JWT_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_64_CHAR_HEX_STRING
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://documind:documind@localhost:5432/documind

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── File Storage ────────────────────────────────────────────
STORAGE_BACKEND=local
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=50

# ─── CORS ───────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ─── Phase 6+: Google OAuth ──────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ─── Phase 7+: Microsoft OAuth ───────────────────────────────
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=

# ─── Phase 2: AI Extraction & OCR ────────────────────────────
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash
OCR_ENABLED=true
OCR_LANGUAGE=eng
AI_REQUEST_TIMEOUT=30
EXTRACTION_CONFIDENCE_THRESHOLD=0.75

# ─── Phase 10+: AWS S3 ───────────────────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=documind-documents
